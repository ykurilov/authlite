{
  "name": "authlite-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm --filter @ykurilov/authlite build",
    "test": "pnpm --filter @ykurilov/authlite test",
    "build:examples": "pnpm --filter \"./examples/**\" build",
    "e2e": "pnpm build && pnpm build:examples && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
